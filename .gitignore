node_modules/
# Root-anchored: a nested `dist` is a fixture SOURCE directory, not build output.
# `app/dist/route.js` is the Next fixture proving that a directory named like build
# output is still a URL segment (E-081), and a bare `dist/` rule silently dropped the
# one file its test asserts on — git cannot re-include a file under an excluded dir.
/dist/
coverage/
.sparda/
*.log
.env
.env.*
.DS_Store
__pycache__/
*.pyc
tests/.tmp/
bench/.tmp/
*.bak
sparda_test_state_*/
scratch/
mcp-publisher.exe
mcp-publisher.tar.gz
tools/corpus/.tmp/
tools/fuzzer/bilan-fuzzing-ia.json

# the release gate writes its verdict here so a blocked publish is recoverable
# after npm has swallowed the output; it must never make the tree look dirty
.sparda-release-gate.log

# mutation harness crash journal — restored by the next run (E-108)
tests/mutation/.in-flight.json
